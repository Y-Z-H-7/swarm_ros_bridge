<launch>
  <node pkg="swarm_ros_bridge" type="bridge_node" name="swarm_bridge_node_gcs" output="screen" >
    <rosparam command="load" file="$(find swarm_ros_bridge)/config/ros_topics_gcs.yaml" />
    <rosparam command="load" file="$(find swarm_ros_bridge)/config/scheduler_gcs.yaml" />
  </node>
</launch>
